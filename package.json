{
  "name": "@mane087/local-docs",
  "version": "0.1.3",
  "description": "Visor local de documentacion markdown, sin configuracion",
  "scripts": {
    "test": "vitest run",
    "build": "npm run build:server && npm run build:client",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "vite build",
    "prepublishOnly": "npm run build",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "docs",
    "markdown",
    "documentacion",
    "viewer",
    "cli",
    "local"
  ],
  "author": "Jesus Emmanuel Alaniz Mancilla",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "local-docs": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.4.1",
    "happy-dom": "^20.13.2",
    "mermaid": "^11.17.2",
    "preact": "^10.29.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "gray-matter": "^4.0.3",
    "markdown-it": "^15.0.1",
    "markdown-it-anchor": "^9.2.1",
    "minisearch": "^7.2.0",
    "shiki": "^4.4.3"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
